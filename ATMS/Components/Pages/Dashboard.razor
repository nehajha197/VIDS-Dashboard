    const ctx = canvas.getContext('2d');
    const remaining = Math.max(0, 100 - violatedPercent);
    const borderColor = isDark ? '#1e293b' : '#ffffff';

    window.violationDonutInstance = new Chart(ctx, {
    type: 'doughnut',
    data: {
    labels: ['Violated', 'Total'],
