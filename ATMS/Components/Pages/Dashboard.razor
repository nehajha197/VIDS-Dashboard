    private string GetPeakHour()
    {
        if (averageVehicleCount is null || !averageVehicleCount.Any()) return "-";
        var peak = averageVehicleCount.OrderByDescending(x => x.TrafficCount).First();
        return peak.Time;
    }

    private string GetPeakValue()
    {
        if (averageVehicleCount is null || !averageVehicleCount.Any()) return "0";
        return averageVehicleCount.Max(x => x.TrafficCount).ToString();
    }

    private string GetAverage()
    {
        if (averageVehicleCount is null || !averageVehicleCount.Any()) return "0";
        return averageVehicleCount.Average(x => x.TrafficCount).ToString("0.0");
    }

// ---- Auto-Refresh ----
private bool isAutoRefresh = true;
private int autoRefreshInterval = 30; // seconds
private PeriodicTimer? autoRefreshTimer;
private CancellationTokenSource? autoRefreshCts;
private Task? autoRefreshLoopTask;
private DateTime lastRefreshTime = DateTime.Now;

private async Task ToggleAutoRefresh()
{
    isAutoRefresh = !isAutoRefresh;

    if (isAutoRefresh)
    {
        StartAutoRefresh();
    }
    else
    {
        StopAutoRefresh();
    }

    StateHasChanged();
}

private void StopAutoRefresh()
{
    autoRefreshCts?.Cancel();
    autoRefreshTimer?.Dispose();
    autoRefreshTimer = null;
    autoRefreshCts?.Dispose();
    autoRefreshCts = null;
}

private void RestartAutoRefresh()
{
    if (isAutoRefresh)
    {
        StartAutoRefresh();
    }
}

private void StartAutoRefresh()
{
    StopAutoRefresh(); // Ensure any existing loop is stopped

    autoRefreshCts = new CancellationTokenSource();
    autoRefreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(autoRefreshInterval));

    autoRefreshLoopTask = RunAutoRefreshLoopAsync(autoRefreshTimer, autoRefreshCts.Token);
}

private async Task RunAutoRefreshLoopAsync(PeriodicTimer timer, CancellationToken token)
{
    try
    {
        while (await timer.WaitForNextTickAsync(token))
        {
            try
            {
                await LoadDashboardDataAsync();
                lastRefreshTime = DateTime.Now;
                errorMessage = null; // clear any previous error once a refresh succeeds

                await InvokeAsync(async () =>
                {
                    await RerenderChartsForTheme();
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                errorMessage = $"Auto-refresh failed: {ex.Message}";
                await InvokeAsync(StateHasChanged);
            }
        }
    }
    catch (OperationCanceledException)
    {
        // Expected when StopAutoRefresh/Dispose cancels the loop
    }

}

// IDisposable implementation
public void Dispose()
{
    lastTransactionTimer?.Dispose();
    StopAutoRefresh();
    GC.SuppressFinalize(this);
        {
            SidebarState.OnChange -= StateHasChanged;
        }
}


