            new() { Name = "Car",     Count = vehicleClass?.Car     ?? 0, Icon = Icons.Material.Filled.DirectionsCar,  Color = "#3b82f6" },
            new() { Name = "Auto",    Count = vehicleClass?.Auto    ?? 0, Icon = Icons.Material.Filled.LocalTaxi,      Color = "#ef4444" },
            new() { Name = "Truck",   Count = vehicleClass?.Truck   ?? 0, Icon = Icons.Material.Filled.LocalShipping,  Color = "#10b981" },
            new() { Name = "LCV",     Count = vehicleClass?.LCV     ?? 0, Icon = Icons.Material.Filled.LocalShipping,  Color = "#0ea5e9" },
            new() { Name = "Bus",     Count = vehicleClass?.Bus     ?? 0, Icon = Icons.Material.Filled.DirectionsBus,  Color = "#a855f7" },
            new() { Name = "Pickup",  Count = vehicleClass?.Pickup  ?? 0, Icon = Icons.Material.Filled.AirportShuttle, Color = "#06b6d4" },
            new() { Name = "Tractor", Count = vehicleClass?.Tractor ?? 0, Icon = Icons.Material.Filled.Agriculture,    Color = "#8b5cf6" },
            new() { Name = "Others",  Count = vehicleClass?.Others  ?? 0, Icon = Icons.Material.Filled.DirectionsCar,  Color = "#64748b" },
        };

        // ---- Violation by Category ----
        violationRows = violationCategories
            .Select(vc => new ViolationRow
            {
                EventType = vc.EventType ?? "Unknown",
                BadgeClass = GetBadgeClassForEventType(vc.EventType),
                Values = new Dictionary<string, int>
                {
                    ["Auto"] = vc.Auto,
                    ["Bike"] = vc.Bike,
                    ["Car"] = vc.Car,
                    ["LCV"] = vc.LCV,
                    ["Truck"] = vc.Truck,
                    ["Bus"] = vc.Bus,
                    ["Pickup"] = vc.Pickup,
                    ["Tractor"] = vc.Tractor,
                    ["Others"] = vc.Others,
                }
            })
            .ToList();

        // ---- Last Transaction ----
        if (lastTransaction != null)
        {
            LastTransactionEventType = lastTransaction.EventType ?? LastTransactionEventType;
            LastTransactionVehicleClass = lastTransaction.VehicleClass ?? LastTransactionVehicleClass;
            LastTransactionLocation = lastTransaction.ChNo ?? LastTransactionLocation;
            LastTransactionTime = lastTransaction.TimeStamp ?? LastTransactionTime;
            // LastTransactionImageUrl / LastTransactionVideoUrl stay as placeholders until
            // LastTransactionDto exposes Image/Video columns from the DB.
        }

        // ---- Recent Vehicles Violation table ----
        violationEvents = passingVehicles
            .Select(p => new ViolationEvent
            {
                EventType = p.EventType ?? "Unknown",
                VehicleClass = p.VehicleClass ?? "Unknown",
                Timestamp = p.TimeStamp ?? DateTime.Now,
                Location = p.Location ?? "-",
                ImageUrl = p.Image ?? LastTransactionImageUrl, // PassingVehicleDto has no video column yet
                VideoUrl = LastTransactionVideoUrl
            })
            .ToList();
    }
        private string GetBadgeClassForEventType(string? eventType) => eventType?.Trim().ToUpperInvariant() switch
    {
        "WRONG DIRECTION" => "wrong-direction",
        "VEHICLE STOPPED" => "stopped",
        _ => "default"
    };

protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var storedTheme = await JS.InvokeAsync<string?>("localStorage.getItem", "vids-theme");
                if (storedTheme == "dark")
                {
                      isDarkMode = true;
                    StateHasChanged();
                }
            }
            catch
            {
                // Ignore storage errors (e.g. private browsing restrictions)
            }
        }

        if (averageVehicleCount is not null && averageVehicleCount.Any())
        {
            var labels = averageVehicleCount.Select(x => x.Time).ToArray();
            var data = averageVehicleCount.Select(x => x.TrafficCount).ToArray();

            await JS.InvokeVoidAsync("renderAvtChart", labels, data, isDarkMode);
        }

        await JS.InvokeVoidAsync("renderViolationDonut", ViolatedPercent, isDarkMode);
        await JS.InvokeVoidAsync("renderDeviceStatusDonut", OnlineDevices, OfflineDevices, isDarkMode);

        if (firstRender)
        {
            var vcLabels = vehicleClasses.Select(x => x.Name).ToArray();
            var vcData = vehicleClasses.Select(x => x.Count).ToArray();
            var vcColors = vehicleClasses.Select(x => x.Color).ToArray();
            await JS.InvokeVoidAsync("renderVehicleClassDonut", vcLabels, vcData, vcColors, isDarkMode);
        }
    }

