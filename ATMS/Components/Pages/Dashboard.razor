                        callbacks: {
                            label: (item) => item.label + ': ' + item.formattedValue
                        }
                    }
                }
            }
        });
    };

    window.vehicleClassDonutInstance = null;

    window.renderVehicleClassDonut = (labels, data, colors, isDark) => {
        const canvas = document.getElementById('vehicleClassDonutCanvas');
        if (!canvas) return;

        if (window.vehicleClassDonutInstance) {
            window.vehicleClassDonutInstance.destroy();
        }

        const ctx = canvas.getContext('2d');
        const borderColor = isDark ? '#1e293b' : '#ffffff';

        window.vehicleClassDonutInstance = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    backgroundColor: colors,
                    borderWidth: 2,
                    borderColor: borderColor,
                    cutout: '70%'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#111827',
                        titleColor: '#f9fafb',
                        bodyColor: '#f9fafb',
                        padding: 8,
                        cornerRadius: 8,
                        titleFont: { size: 10 },
                        bodyFont: { size: 10 },
                        callbacks: {
                            label: (item) => item.label + ': ' + item.formattedValue
                        }
                    }
                }
            }
        });
    };

    
    // Function to apply dark mode to entire page
    window.applyDarkModeToPage = function(isDark) {
        // Apply to body
        if (isDark) {
            document.body.classList.add('dark-mode');
            document.body.style.backgroundColor = '#0f172a';
        } else {
            document.body.classList.remove('dark-mode');
            document.body.style.backgroundColor = '';
        }
        
        // Apply to main layout
        const mainElement = document.querySelector('main');
        if (mainElement) {
            if (isDark) {
                mainElement.classList.add('dark-mode');
                mainElement.style.backgroundColor = '#0f172a';
            } else {
                mainElement.classList.remove('dark-mode');
                mainElement.style.backgroundColor = '';
            }
        }
        
        // Apply to top row
        const topRow = document.querySelector('.top-row.px-4');
        if (topRow) {
            if (isDark) {
                topRow.style.backgroundColor = '#0f172a';
                topRow.style.borderBottom = '1px solid #334155';
            } else {
                topRow.style.backgroundColor = '';
                topRow.style.borderBottom = '';
            }
        }
        
        // Apply to content
        const content = document.querySelector('.content.px-4');
        if (content) {
            if (isDark) {
                content.style.backgroundColor = '#0f172a';
            } else {
                content.style.backgroundColor = '';
            }
        }
        
        // Apply to page container
        const page = document.querySelector('.page');
        if (page) {
            if (isDark) {
                page.style.backgroundColor = '#0f172a';
            } else {
                page.style.backgroundColor = '';
            }
        }
        
        // Save preference
        localStorage.setItem('vids-theme', isDark ? 'dark' : 'light');
    };

    // Check and apply dark mode on page load
    document.addEventListener('DOMContentLoaded', function() {
        const theme = localStorage.getItem('vids-theme');
        if (theme === 'dark') {
            window.applyDarkModeToPage(true);
        }
    });

    // Listen for storage changes
    window.addEventListener('storage', function(e) {
        if (e.key === 'vids-theme') {
            const isDark = e.newValue === 'dark';
            window.applyDarkModeToPage(isDark);
        }
    });
</script>


