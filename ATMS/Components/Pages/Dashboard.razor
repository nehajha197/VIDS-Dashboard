    window.deviceStatusDonutInstance = null;

    window.renderDeviceStatusDonut = (online, offline, isDark) => {
        const canvas = document.getElementById('deviceStatusDonutCanvas');
        if (!canvas) return;

        if (window.deviceStatusDonutInstance) {
            window.deviceStatusDonutInstance.destroy();
        }

        const ctx = canvas.getContext('2d');
        const borderColor = isDark ? '#1e293b' : '#ffffff';

        window.deviceStatusDonutInstance = new Chart(ctx, {
