@page "/"
@rendermode InteractiveServer  
@using static ATMS.DTOs.DTO
@using ATMS.Interfaces
@implements IDisposable
@inject IVidsDataService VidsDataService
@inject IDialogService DialogService
@inject SidebarStateService SidebarState


<PageTitle>VIDS Dashboard</PageTitle>

@using System.Text.Json
@inject IJSRuntime JS


<VidsSidebar ReportsRoute="/vids-report" GisRoute="/gisdashboard"  ActiveMenu="VIDS">

  <div class="@RootCssClass">

            <div class="dashboard-topbar">
                <div class="dashboard-topbar-left">

                    <button class="sidebar-toggle-btn" @onclick="SidebarState.Toggle" title="Hide menu">
                        <MudIcon Icon="@Icons.Material.Filled.Menu" Size="Size.Small" />
                    </button>

                    <div class="dashboard-topbar-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Dashboard" Style="color:#ffffff;" />
                    </div>
                    <div class="dashboard-topbar-text">
                        <h1>VIDS Dashboard</h1>
                        <p>Vehicle Intrusion Detection System &middot; Live Overview</p>
                    </div>
                </div>
        

        <div class="dashboard-topbar-right">
            <div class="dashboard-topbar-right">
    <!-- Auto-refresh controls -->
    <div class="auto-refresh-controls">
       
        <span class="auto-refresh-status">
            <span class="auto-refresh-dot @(isAutoRefresh ? "active" : "inactive")"></span>
           <!-- <span class="">@(isAutoRefresh ? $"Auto-refresh {autoRefreshInterval}s" : "Paused")</span>-->
        </span>
    </div>

            <button class="theme-toggle" @onclick="ToggleDarkMode"
                     title="@(isDarkMode ? "Switch to light mode" : "Switch to dark mode")"
                     aria-label="Toggle dark mode">
                <span class="theme-toggle-icon sun">
                    <MudIcon Icon="@Icons.Material.Filled.LightMode" Size="Size.Small" />
                </span>
                <span class="theme-toggle-track @(isDarkMode ? "on" : "")">
                    <span class="theme-toggle-thumb">
                        <MudIcon Icon="@(isDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)" Size="Size.Small" />
                    </span>
                </span>
                <span class="theme-toggle-icon moon">
                    <MudIcon Icon="@Icons.Material.Filled.DarkMode" Size="Size.Small" />
                </span>
            </button>
        </div>
    </div>
    </div>
    


<MudGrid Spacing="3">

    <MudItem xs="12" sm="6" md="4">
        <MudPaper Elevation="3" Height="250px" Class="pa-4 traffic-card">
            <div class="traffic-header">
                <div class="traffic-header-left">
                    <MudIcon Icon="@Icons.Material.Filled.Traffic" Size="Size.Medium" Class="traffic-icon" />
                    <h5 class="traffic-title">
                        Chno By Traffic&nbsp;<span class="traffic-title-value">@ChNoTotal</span>
                    </h5>
                </div>
                <MudChip T="string" Class="traffic-location-chip" Size="Size.Small" Variant="Variant.Outlined">
                    @TrafficByChNo.Count Location@(TrafficByChNo.Count == 1 ? "" : "s")
                </MudChip>
            </div>

            <div class="traffic-rows">
                @foreach (var item in TrafficByChNo)
                {
                    <div class="traffic-row">
                        <div class="traffic-row-bar"></div>
                        <MudIcon Icon="@Icons.Material.Filled.AltRoute" Size="Size.Small" Class="traffic-row-icon" />
                        <span class="traffic-row-label">@item.LocationCode</span>
                        <MudChip T="string" Class="traffic-count-pill" Size="Size.Small">
                            @item.Count.ToString("N0")
                        </MudChip>
                    </div>
                }
            </div>
        </MudPaper>
    </MudItem>
    
 <MudItem xs="12" sm="6" md="4">
        <MudPaper Elevation="3" Height="250px" Class="pa-0">
            <div class="dvs-page">

                <div class="dvs-header">
                    <div class="dvs-header-left">
                        <div class="dvs-header-icon">
                            <MudIcon Icon="@Icons.Material.Filled.DeviceHub" Size="Size.Small" Style="color:#ffffff;" />
                        </div>
                        <div class="dvs-header-text">
                            <h1>Device Status</h1>
                            <p>Realtime connectivity overview</p>
                        </div>
                    </div>
                    <!--<span class="dvs-live-badge"><span class="dvs-live-dot"></span>Live</span>-->
                </div>

                <div class="dvs-body">
                    <div class="dvs-donut-wrap">
                        <canvas id="deviceStatusDonutCanvas"></canvas>
                        <div class="dvs-donut-center">
                            <span class="dvs-donut-value">@TotalDevices</span>
                            <span class="dvs-donut-label">Total</span>
                        </div>
                    </div>

                    <div class="dvs-stats">
                        <div class="dvs-stat-row online">
                            <div class="dvs-stat-row-top">
                                <span class="dvs-dot online"></span>
                                <span class="dvs-stat-name">Online</span>
                                <span class="dvs-stat-count">@OnlineDevices</span>
                            </div>
                            <div class="dvs-bar-track">
                                <div class="dvs-bar-fill online" style="width:@(OnlinePercent)%"></div>
                            </div>
                        </div>

                        <div class="dvs-stat-row offline">
                            <div class="dvs-stat-row-top">
                                <span class="dvs-dot offline"></span>
                                <span class="dvs-stat-name">Offline</span>
                                <span class="dvs-stat-count">@OfflineDevices</span>
                            </div>
                            <div class="dvs-bar-track">
                                <div class="dvs-bar-fill offline" style="width:@(OfflinePercent)%"></div>
                            </div>
                        </div>

                        <div class="dvs-uptime">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="dvs-uptime-icon" />
                            <span>@OnlinePercent.ToString("0.0")% uptime</span>
                        </div>
                    </div>
                </div>

            </div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudPaper Elevation="3" Height="250px" Class="pa-4 violation-card">
            <div class="violation-header">
                <div class="violation-header-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" Style="color:#ffffff;" />
                </div>
                <h5 class="violation-title">Avg Violation &amp; Violations</h5>
            </div>

            <div class="violation-body">
                <div class="violation-left">
                    <div class="violation-icon-circle">
                        <MudIcon Icon="@Icons.Material.Filled.CarCrash" Size="Size.Large" Style="color:#3b82f6;" />
                    </div>
                    <div class="violation-value">@AvgViolationPerHour.ToString("0.00")</div>
                    <div class="violation-sublabel">violation/h</div>
                </div>

                <div class="violation-vdivider"></div>

                <div class="violation-right">
                    <div class="violation-donut-wrap">
                        <canvas id="violationDonutCanvas"></canvas>
                        <div class="violation-donut-center">@ViolatedPercentLabel</div>
                    </div>
                    <div class="violation-legend">
                        <div class="violation-legend-item">
                            <span class="violation-legend-label violated">Violated</span>
                            <span class="violation-legend-value">@ViolatedCount.ToString("N0")</span>
                        </div>
                        <div class="violation-legend-sep"></div>
                        <div class="violation-legend-item">
                            <span class="violation-legend-label total">Total</span>
                            <span class="violation-legend-value">@TotalCount.ToString("N0")</span>
                        </div>
                    </div>
                </div>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="9" md="6">
        <MudPaper Elevation="3" Height="300px" Class="pa-0">
            <div class="avt-page">

                <div class="avt-header">
                    <div class="avt-header-left">
                        <div class="avt-header-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Timeline" Size="Size.Small" Style="color:#ffffff;" />
                        </div>
                        <div class="avt-header-text">
                            <h1>Average Vehicle Traffic</h1>
                            <p>Hourly average over a 24-hour period</p>
                        </div>
                    </div>
                </div>

                <div class="avt-stats-row">
                    <div class="avt-stat peak-hour">
                        <div class="avt-stat-icon-wrap">
                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                        </div>
                        <div class="avt-stat-text">
                            <span class="avt-stat-value">@GetPeakHour()</span>
                            <span class="avt-stat-label">Peak Hour</span>
                        </div>
                    </div>
                    <div class="avt-stat peak-count">
                        <div class="avt-stat-icon-wrap">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" />
                        </div>
                        <div class="avt-stat-text">
                            <span class="avt-stat-value">@GetPeakValue()</span>
                            <span class="avt-stat-label">Peak Count</span>
                        </div>
                    </div>
                    <div class="avt-stat avg-hour">
                        <div class="avt-stat-icon-wrap">
                            <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Small" />
                        </div>
                        <div class="avt-stat-text">
                            <span class="avt-stat-value">@GetAverage()</span>
                            <span class="avt-stat-label">Avg / Hour</span>
                        </div>
                    </div>
                </div>

                <div class="avt-card">
                    @if (averageVehicleCount is null || !averageVehicleCount.Any())
                    {
                        <div class="avt-empty">
                            <MudIcon Icon="@Icons.Material.Filled.ShowChart" Size="Size.Medium" Class="avt-empty-icon" />
                            <p>No traffic data available yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="avt-chart-wrap">
                            <canvas id="avtChartCanvas"></canvas>
                        </div>
                    }
                </div>

            </div>
        </MudPaper>
    </MudItem>

<MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="3" Height="300px" Class="pa-0">
            <div class="vcd-page">

                <div class="vcd-header">
                    <div class="vcd-header-left">
                        <div class="vcd-header-icon">
                            <MudIcon Icon="@Icons.Material.Filled.DirectionsCar" Size="Size.Small" Style="color:#ffffff;" />
                        </div>
                        <div class="vcd-header-text">
                            <h1>Vehicle Class Distribution</h1>
                            <p>@TotalVehicleClassCount.ToString("N0") vehicles classified</p>
                        </div>
                    </div>
                    <button class="vcd-sort-btn" @onclick="ToggleVehicleClassSort">
                        <MudIcon Icon="@(sortDescending ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)" Size="Size.Small" />
                        @(sortDescending ? "Highest" : "Lowest")
                    </button>
                </div>

                <div class="vcd-body">
                    <div class="vcd-donut-wrap">
                        <canvas id="vehicleClassDonutCanvas"></canvas>
                        <div class="vcd-donut-center">
                            <span class="vcd-donut-value">@TotalVehicleClassCount.ToString("N0")</span>
                            <span class="vcd-donut-label">Total</span>
                        </div>
                    </div>

                    <div class="vcd-list">
                        @foreach (var item in SortedVehicleClasses)
                        {
                            <div class="vcd-row">
                                <div class="vcd-row-icon" style="background:@(item.Color)1a; color:@item.Color;">
                                    <MudIcon Icon="@item.Icon" Size="Size.Small" />
                                </div>
                                <div class="vcd-row-main">
                                    <div class="vcd-row-top">
                                        <span class="vcd-row-name">@item.Name</span>
                                        <span class="vcd-row-count">@item.Count.ToString("N0")</span>
                                        <span class="vcd-row-pct">@item.Percent.ToString("0.0")%</span>
                                    </div>
                                    <div class="vcd-bar-track">
                                        <div class="vcd-bar-fill" style="width:@(item.Percent)%; background:@item.Color;"></div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

            </div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
    <MudPaper Elevation="3" Height="300px" Class="pa-0">
        <div class="voc-card">

            <div class="voc-header">
                <div class="voc-header-left">
                    <div class="voc-header-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" Style="color:#ffffff;" />
                    </div>
                    <div class="voc-header-text">
                        <h1>Violation by Category</h1>
                        <p>Breakdown by event type &amp; vehicle class</p>
                    </div>
                </div>  
            </div>

            <div class="voc-summary">
                <div class="voc-summary-item">
                    <span class="voc-summary-value">@GrandTotal.ToString("N0")</span>
                    <span class="voc-summary-label">Total Violations</span>
                </div>
                <div class="voc-summary-divider"></div>
                <div class="voc-summary-item">
                    <span class="voc-summary-value">@TopEventType</span>
                    <span class="voc-summary-label">Top Event Type</span>
                </div>
                <div class="voc-summary-divider"></div>
                <div class="voc-summary-item">
                    <span class="voc-summary-value">@TopVehicleClass</span>
                    <span class="voc-summary-label">Top Vehicle Class</span>
                </div>
            </div>

            <div class="voc-search-wrap">
                <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="voc-search-icon" />
                <input class="voc-search-input"
                       placeholder="Search event type..."
                       @bind="vbcSearchTerm"
                       @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(vbcSearchTerm))
                {
                    <button class="voc-search-clear" @onclick="() => vbcSearchTerm = string.Empty">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                    </button>
                }
            </div>

            <div class="voc-list">
                @foreach (var row in FilteredViolationRows)
                {
                    var pct = GrandTotal == 0 ? 0 : Math.Round((double)row.Total / GrandTotal * 100, 1);
                    var accent = GetRowAccentColor(row.BadgeClass);
                    var isOpen = expandedRow == row.EventType;

                    <div class="voc-row @(isOpen ? "expanded" : "")">
                        <div class="voc-row-header" @onclick="() => ToggleRow(row.EventType)">
                            <span class="voc-event-badge @row.BadgeClass">@row.EventType</span>

                            <div class="voc-row-bar-track">
                                <div class="voc-row-bar-fill" style="width:@(pct)%; background:@accent;"></div>
                            </div>

                            <span class="voc-row-total">@row.Total.ToString("N0")</span>
                            <span class="voc-row-pct">@(pct.ToString("0.0"))%</span>

                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Class="voc-chevron" />
                        </div>

                        @if (isOpen)
                        {
                            <div class="voc-row-detail">
                                @{
                                    var nonZero = row.Values.Where(v => v.Value > 0).OrderByDescending(v => v.Value).ToList();
                                }
                                @if (!nonZero.Any())
                                {
                                    <div class="voc-detail-empty">No vehicles recorded for this event type.</div>
                                }
                                else
                                {
                                    @foreach (var kv in nonZero)
                                    {
                                        var barPct = row.MaxValue == 0 ? 0 : Math.Round((double)kv.Value / row.MaxValue * 100, 1);
                                        <div class="voc-detail-item">
                                            <span class="voc-detail-label">@kv.Key</span>
                                            <div class="voc-detail-bar-track">
                                                <div class="voc-detail-bar-fill" style="width:@(barPct)%; background:@accent;"></div>
                                            </div>
                                            <span class="voc-detail-value">@kv.Value.ToString("N0")</span>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }

                @if (!FilteredViolationRows.Any())
                {
                    <div class="voc-empty">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Medium" Class="voc-empty-icon" />
                        <p>No matching event types.</p>
                    </div>
                }
            </div>

            <div class="voc-footer">
                Showing @FilteredViolationRows.Count() of @violationRows.Count event types
            </div>

        </div>
    </MudPaper>
</MudItem>

<MudItem xs="12" sm="9" md="6">
        <MudPaper Elevation="3" Height="350px" Class="pa-0">
            <div class="ltx-page">

                <div class="ltx-header">
                    <div class="ltx-header-left">
                        <div class="ltx-header-icon">
                            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" Style="color:#ffffff;" />
                        </div>
                        <div class="ltx-header-text">
                            <h1>Last Transaction</h1>
                            <p>Most recent captured event</p>
                        </div>
                    </div>
                    
                </div>

                <div class="ltx-media-row">
                <div class="ltx-media-tile" @onclick="ExpandImageMedia">
                        <img src="@LastTransactionImageUrl" alt="Captured frame" class="ltx-media-img" />
                        <span class="ltx-media-tag image">
                            <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Size="Size.Small" /> Snapshot
                        </span>
                        <span class="ltx-media-expand">
                            <MudIcon Icon="@Icons.Material.Filled.ZoomIn" Size="Size.Small" />
                        </span>
                    </div>

                    <div class="ltx-media-tile video-tile"    @onclick="ExpandVideoMedia">
                        <video class="ltx-media-video" id="ltxVideoPlayer" controls muted preload="metadata" poster="@LastTransactionImageUrl">
                            <source src="@LastTransactionVideoUrl" type="video/mp4" />
                        </video>
                        <span class="ltx-media-tag video">
                            <MudIcon Icon="@Icons.Material.Filled.Videocam" Size="Size.Small" /> Clip
                        </span>
                    </div>
                </div>

                <div class="ltx-info-row">
                    <div class="ltx-info-item">
                        <span class="ltx-info-label">Event Type</span>
                        <span class="ltx-badge @EventTypeClass">
                            <MudIcon Icon="@EventTypeIcon" Size="Size.Small" />
                            @LastTransactionEventType
                        </span>
                    </div>
                    <div class="ltx-info-item">
                        <span class="ltx-info-label">Vehicle Class</span>
                        <span class="ltx-badge vclass">
                            <MudIcon Icon="@Icons.Material.Filled.DirectionsCar" Size="Size.Small" />
                            @LastTransactionVehicleClass
                        </span>
                    </div>
                    <div class="ltx-info-item">
                        <span class="ltx-info-label">Location</span>
                        <span class="ltx-badge location">
                            <span class="ltx-location-dot" style="background:@LastTransactionLocationColor;"></span>
                            @LastTransactionLocation
                        </span>
                    </div>
                    <div class="ltx-info-item">
                        <span class="ltx-info-label">Captured</span>
                        <span class="ltx-timestamp">
                            <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" />
                            @LastTransactionTime.ToString("dd-MMM-yyyy HH:mm:ss")
                        </span>
                    </div>
                </div>

            </div>
        </MudPaper>
    </MudItem> 

   <MudItem xs="12" sm="9" md="6">
    <MudPaper Elevation="3" Height="350px" Class="pa-4 rvv-card">
        <div class="rvv-container">
            <!-- Header -->
            <div class="rvv-header">
                <div class="rvv-header-left">
                    <div class="rvv-header-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Style="color:#ffffff;" />
                    </div>
                    <div>
                        <h5 class="rvv-title">Recent Vehicles Violation</h5>
                        <p class="rvv-subtitle">Latest violation events captured by the system</p>
                    </div>
                </div>
                <div class="rvv-header-right">
                    <span class="rvv-badge">@violationEvents.Count Events</span>
                   
                </div>
            </div>

            <!-- Table -->
            <div class="rvv-table-wrap">
                <table class="rvv-table">
                    <thead>
                        <tr>
                            <th>Event Type</th>
                            <th>Vehicle Class</th>
                            <th>Timestamp</th>
                            <th>Location</th>
                            <th>Media</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in violationEvents.Take(5))
                        {
                            <tr class="rvv-row" @onclick="() => OnRowClick(item)">
                                <td>
                                    <span class="rvv-event-badge @item.EventTypeClass">
                                        <MudIcon Icon="@GetEventIcon(item.EventType)" Size="Size.Small" Class="extra-small-icon"  />
                                        @item.EventType
                                    </span>
                                </td>
                                <td>
                                    <span class="rvv-vehicle-class">
                                        <MudIcon Icon="@GetVehicleIcon(item.VehicleClass)" Size="Size.Small" />
                                        @item.VehicleClass
                                    </span>
                                </td>
                                <td>
                                    <span class="rvv-timestamp">
                                        <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" />
                                        @item.Timestamp.ToString("dd-MMM-yyyy HH:mm:ss")
                                    </span>
                                </td>
                                <td>
                                    <span class="rvv-location">
                                        <span class="rvv-location-dot" style="background:@GetLocationColor(item.Location);"></span>
                                        @item.Location
                                    </span>
                                </td>
                                <td>
                                    <div class="rvv-media-icons">
                                        <button class="rvv-media-btn image" @onclick:stopPropagation="true" @onclick='() => OpenMedia(item, "image")'>
                                            <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Size="Size.Small" />
                                        </button>
                                        <button class="rvv-media-btn video" @onclick:stopPropagation="true" @onclick='() => OpenMedia(item, "video")'>
                                            <MudIcon Icon="@Icons.Material.Filled.Videocam" Size="Size.Small" />
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Footer -->
            <div class="rvv-footer">
                <span>Showing @Math.Min(5, violationEvents.Count) of @violationEvents.Count vehicles</span>
                <button class="rvv-view-all" @onclick="ViewAll">
                    View All
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                </button>
            </div>
        </div>
    </MudPaper>
</MudItem>
</MudGrid>

</div>
</VidsSidebar>


<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"> </script>


<script>
   window.avtChartInstance = null;

    window.renderAvtChart = (labels, data, isDark) => {
        const canvas = document.getElementById('avtChartCanvas');
        if (!canvas) return;

        if (window.avtChartInstance) {
            window.avtChartInstance.destroy();
        }

        const ctx = canvas.getContext('2d');
        const gradient = ctx.createLinearGradient(0, 0, 0, 180);
        gradient.addColorStop(0, 'rgba(99, 102, 241, 0.38)');
        gradient.addColorStop(0.6, 'rgba(99, 102, 241, 0.08)');
        gradient.addColorStop(1, 'rgba(99, 102, 241, 0)');

        const gridColor = isDark ? 'rgba(148, 163, 184, 0.12)' : '#f3f4f6';
        const tickColor = isDark ? '#94a3b8' : '#9ca3af';
        const axisColor = isDark ? '#334155' : '#e5e7eb';

        window.avtChartInstance = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Vehicle Count',
                    data: data,
                    borderColor: '#6366f1',
                    backgroundColor: gradient,
                    borderWidth: 2.5,
                    pointRadius: 0,
                    pointHoverRadius: 6,
                    pointHoverBackgroundColor: '#ffffff',
                    pointHoverBorderColor: '#6366f1',
                    pointHoverBorderWidth: 3,
                    tension: 0.4,
                    fill: true
                }]
            },
