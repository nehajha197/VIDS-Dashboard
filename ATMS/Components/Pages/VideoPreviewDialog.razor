@using MudBlazor

<MudDialog>
    <TitleContent>
        <div class="dialog-title">
            <MudIcon Icon="@Icons.Material.Filled.Videocam" Size="Size.Small" Class="dialog-title-icon" />
            <span>@Title</span>
        </div>
    </TitleContent>
    <DialogContent>
       @*  <div class="video-preview-container">
            @if (!string.IsNullOrEmpty(VideoUrl))
            {
                <iframe class="video-iframe"
                        src="@VideoUrl"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen>
                </iframe>
            }
            else
            {
                <div class="video-error">
                    <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Large" />
                    <p>No video available</p>
                </div>
            }
        </div> *@
        <div class="video-preview-container">
            @if (!string.IsNullOrEmpty(VideoUrl))
            {
                <video class="video-element" controls autoplay muted poster="@PosterUrl" playsinline>
                    <source src="@VideoUrl" type="video/mp4" />
                    <p class="video-fallback">
                        Your browser doesn't support HTML5 video.
                        <a href="@VideoUrl" target="_blank">Download video</a>
                    </p>
                </video>
            }
            else
            {
                <div class="video-error">
                    <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Large" />
                    <p>No video available</p>
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="CloseDialog">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string VideoUrl { get; set; } = string.Empty;
    [Parameter] public string PosterUrl { get; set; } = string.Empty;
    [Parameter] public string Title { get; set; } = "Clip";

    private void CloseDialog() => MudDialog.Close(DialogResult.Ok(true));
}

<style>
    .dialog-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .dialog-title-icon {
        color: #4f46e5 !important;
    }

    .video-preview-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 400px;
        max-height: 70vh;
        background: #0f172a;
        border-radius: 8px;
        overflow: hidden;
        padding: 10px;
    }

    .video-iframe {
        width: 100%;
        height: 500px;
        max-height: 70vh;
        border-radius: 8px;
        border: none;
    }

    .video-error {
        display: flex;
        flex-direction: column;
        align-items: center;
        color: #94a3b8;
        gap: 10px;
    }

        .video-error .mud-icon-root {
            color: #ef4444 !important;
            font-size: 48px !important;
        }

        .video-error p {
            margin: 0;
            font-size: 16px;
        }

    /* Responsive adjustments */
    @@media (max-width: 640px) {
        .video-iframe {
            height: 300px;
        }
    }
</style>